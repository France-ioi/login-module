{
    "name": "france-ioi/laravelcollective-html",
    "description": "Vendored copy of laravelcollective/html v6.4.1 (abandoned upstream), kept for Laravel 12 compatibility.",
    "license": "MIT",
    "version": "6.4.1",
    "require": {
        "php": ">=8.4",
        "illuminate/http": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/session": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/view": "^12.0"
    },
    "replace": {
        "laravelcollective/html": "6.4.1"
    },
    "autoload": {
        "psr-4": {
            "Collective\\Html\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Collective\\Html\\HtmlServiceProvider"
            ],
            "aliases": {
                "Form": "Collective\\Html\\FormFacade",
                "Html": "Collective\\Html\\HtmlFacade"
            }
        }
    }
}
